# 复制本文件为 .env 再填写（.env 已被 .gitignore 忽略，不要提交）
DEEPSEEK_API_KEY=sk-你的DeepSeekKey
# 如果你在 NapCat 的 WebSocket 服务器里设置了 token，就填在这里；没设置就留空
ONEBOT_ACCESS_TOKEN=
# 可选：单独的视觉模型 Key（OpenAI 兼容服务，比如 SiliconFlow / 智谱）
# 留空即可：DeepSeek-V4.1-Flash 支持图片输入，会自动复用上面的 DEEPSEEK_API_KEY
VISION_API_KEY=
# 可选：官方 QQ 机器人（QQ 开放平台）的 AppID / AppSecret
OFFICIAL_APP_ID=
OFFICIAL_APP_SECRET=
# 可选：WebUI 的访问 token（建议非本机访问时一定要设）
WEB_TOKEN=
